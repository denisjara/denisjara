{
  "name": "metrado-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Metrado Lab — metrados de obra sobre planos PDF, DXF e imagen con lectura exacta de la geometría vectorial",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "build:standalone": "tsc -p tsconfig.app.json --noEmit && VITE_STANDALONE=1 vite build && tsx scripts/build-standalone.ts"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "pdfjs-dist": "6.5.438",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "$vite"
  }
}
